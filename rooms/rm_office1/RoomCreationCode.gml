//Load the Chosen Animatronics
if htme_globalGet("freddyTaken") != "none"
{
	sprite_prefetch(spr_jumpscare_freddy);
	sprite_prefetch(spr_stage_freddy);
	sprite_prefetch(spr_dining_freddy);
	sprite_prefetch(spr_bathroom_freddy);
	sprite_prefetch(spr_lefthall_freddy);
	sprite_prefetch(spr_righthall_freddy);
}
